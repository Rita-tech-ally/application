## Poetry Setup:

# Remove old Ubuntu Poetry package if present:
sudo apt remove -y python3-poetry

# Install current Poetry version:
curl -sSL https://install.python-poetry.org | python3 -

# Add Poetry to your PATH and reload configuration:
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
source ~/.bashrc

# Verify Poetry and configure Python 3.11:
poetry --version
poetry env use /usr/bin/python3.11
poetry env info

# Install Dependencies and Gunicorn:
poetry install --no-root

# Verify psycopg2 can be imported successfully:
poetry run python -c "import psycopg2; print('psycopg2 OK')"

# Add and verify Gunicorn:
poetry add Gunicorn
poetry run gunicorn --version

