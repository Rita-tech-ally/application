##  Database (ScyllaDB) Setup

# ScyllaDB Install aur Start karein:
curl -sSf get.scylladb.com/server | sudo bash
sudo scylla_dev_mode_setup --developer-mode 1
sudo systemctl enable scylla-server
sudo systemctl start scylla-server

# Keyspace (Database)
cqlsh 127.0.0.1 9042

CREATE KEYSPACE employee_db WITH replication = {
    'class': 'NetworkTopologyStrategy', 
    'replication_factor': 1
};

##  Redis (Cache) Setup
# Install aur Start karein:

sudo apt install redis-server -y
sudo systemctl start redis-server
sudo systemctl enable redis-server

## git clone:
git clone https://github.com/OT-MICROSERVICES/employee-api.git
cd employee-api

## Go 1.18
wget https://dl.google.com/go/go1.18.linux-amd64.tar.gz
sudo tar -C /usr/local -xzf go1.18.linux-amd64.tar.gz

echo 'export PATH=$PATH:/usr/local/go/bin' >> ~/.bashrc
source ~/.bashrc

## Migrate Tool Install Karein
# Aap is command se golang-migrate ko apne system par direct install kar sakte hain:
# Latest version download
curl -L https://github.com/golang-migrate/migrate/releases/download/v4.15.2/migrate.linux-amd64.tar.gz | tar xvz
sudo mv migrate /usr/local/bin/

migrate -version

## Run migration:
make run-migrations

## Files migration.json and config.yaml
 change ip to 127.0.0.1

# verify:
go version

## Application build and run:
go mod tidy
make build

## Health check:
curl http://localhost:8080/api/v1/employee/health/detail

## Swagger UI:
http://<server-ip>:8080/swagger/index.html
make pdf
