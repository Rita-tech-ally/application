## Liquibase install: Migration tool tool ( Liquibase ka main kaam database migrations (database changes ko manage aur execute karna) karna hai.)
# Remove any old repository configurations:
sudo rm -f /etc/apt/sources.list.d/liquibase.list
sudo rm -f /usr/share/keyrings/liquibase-keyring.gpg

# Import the Liquibase GPG key and set permissions:
curl -fsSL https://repo.liquibase.com/liquibase.asc | gpg --dearmor | sudo tee /usr/share/keyrings/liquibase-keyring.gpg >/dev/null
sudo chmod 644 /usr/share/keyrings/liquibase-keyring.gpg

# Add the repository and install Liquibase:
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/liquibase-keyring.gpg] https://repo.liquibase.com stable main" | sudo tee /etc/apt/sources.list.d/liquibase.list
sudo apt update
sudo apt install -y liquibase

# Verify installation:
which liquibase
liquibase --version

## Clone:
git clone https://github.com/OT-MICROSERVICES/attendance-api.git

# Download the PostgreSQL JDBC Driver: Database Connection ke liye: Jab Liquibase database migrations run karta hai (jaise 
## tables create karna), toh use PostgreSQL database (attendance_db) ke sath connect aur communicate karne ke liye ek driver ki zaroorat padti hai.
mkdir -p lib
wget -P lib/ https://jdbc.postgresql.org/download/postgresql-42.7.2.jar

## Verify the file exists:
ls -lh lib/

# Configure and Run Liquibase Migrations:

cat > liquibase.properties << 'EOF'
url=jdbc:postgresql://127.0.0.1:5432/attendance_db
username=postgres
password=password
classpath=lib/postgresql-42.7.2.jar
changeLogFile=migration/db.changelog-master.xml
EOF

# Run database migrations:
sudo apt install make 
make run-migrations

## Verify tables in PostgreSQL:
psql -h 127.0.0.1 -U postgres -d attendance_db -c "\dt"

