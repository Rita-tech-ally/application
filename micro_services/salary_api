## clone repo:
git clone https://github.com/OT-MICROSERVICES/salary-api.git
cd salary-api

## Install jave 17: (importantfor  Maven, Make)
sudo apt update
sudo apt install make openjdk-17-jdk maven -y

##  Database (ScyllaDB) Setup

# ScyllaDB Install aur Start karein:
curl -sSf get.scylladb.com/server | sudo bash
sudo scylla_dev_mode_setup --developer-mode 1
sudo systemctl enable scylla-server
sudo systemctl start scylla-server

# Keyspace (Database)
cqlsh
CREATE KEYSPACE employee_db WITH replication = {'class': 'NetworkTopologyStrategy', 'replication_factor': 1};
exit

##  Redis (Cache) Setup
# Install aur Start karein:

sudo apt install redis-server -y
sudo systemctl start redis-server
sudo systemctl enable redis-server

# Migration Setup
# Migrate binary download karein:
wget https://github.com/golang-migrate/migrate/releases/download/v4.16.2/migrate.linux-amd64.tar.gz
tar -xvf migrate.linux-amd64.tar.gz
sudo mv migrate /usr/local/bin/
sudo chmod +x /usr/local/bin/migrate

